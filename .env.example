# LOCAL DEVELOPMENT TEMPLATE. Copy to .env and fill private credentials.
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
HOST=0.0.0.0

# App login/security. Use private random values; never reuse the example JWT.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
SUPER_ADMIN_EMAIL=replace-with-your-owner-email
SUPER_ADMIN_PASSWORD=replace-with-a-unique-strong-password
DEFAULT_ACCESS_DAYS=30

# Firebase Firestore (no Firebase Storage bucket is used).
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Existing Cloudflare R2 bucket for uploaded/print files.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
STORAGE_PROVIDER=r2

# Optional application settings.
MAX_UPLOAD_MB=30
PAYMENT_WEBHOOK_SECRET=
