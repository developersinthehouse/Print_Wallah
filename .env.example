# Server
PORT=3000
NODE_ENV=development
# Public address of the app, used in shop links and QR codes. In production this must be the https:// URL.
# In development a localhost value is replaced by the address you actually open (so phone/LAN QR codes work).
APP_URL=http://localhost:3000
# Interface to listen on. 0.0.0.0 (default) makes the app reachable from other devices on the same Wi-Fi; use 127.0.0.1 to keep it local.
# HOST=0.0.0.0
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
UPLOAD_DIR=./storage
MAX_UPLOAD_MB=30

# PostgreSQL connection string. On Render, use the internal database URL.
DATABASE_URL=postgresql://printing_user:change-me@localhost:5432/printing_platform
# Set true only for hosted PostgreSQL providers that require TLS.
DATABASE_SSL=false

# The first super-admin account is read from environment variables.
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=change-this-to-a-long-unique-password
DEFAULT_ACCESS_DAYS=30

# Optional: automatic UPI confirmation. Leave unset for manual verification by the shop.
# Set to a random string of 24+ characters to enable POST /api/payments/webhook (see docs/PAYMENTS.md).
# PAYMENT_WEBHOOK_SECRET=
