{
  "server_url": "https://your-render-service.onrender.com",
  "shop_id": "SHOP_PUBLIC_ID",
  "agent_token": "COPY_ONCE_FROM_SUPER_ADMIN",
  "agent_name": "Front counter PC",
  "printer_name": "Office Printer",
  "allow_glossy": false,
  "poll_seconds": 8,
  "print_command": [
    "lp", "-d", "{printer}", "-n", "{copies}", "-P", "{page_range}",
    "-o", "media={paper_size}", "-o", "print-color-mode={color}",
    "-o", "sides={duplex}", "-o", "orientation-requested={orientation}",
    "-o", "print-scaling={scaling}", "{file}"
  ]
}
